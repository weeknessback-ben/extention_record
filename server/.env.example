# Meeting processing server. Copy to .env (chmod 600). Comments must be on their own line:
# systemd's EnvironmentFile does not strip trailing comments.

# Keys the extension uses (Settings → Processing → API key), comma-separated.
API_KEYS=
HOST=127.0.0.1
PORT=8120
DATA_DIR=/home/ubuntu/proyek/meeting-server/data
# Audio and screenshots are deleted after this many days (0 = keep); the minutes, chosen slides and
# PDF stay for /notulen in Telegram until NOTES_RETENTION_DAYS (0 = keep forever).
RETENTION_DAYS=7
NOTES_RETENTION_DAYS=365
# Language of the server's own texts (PDF footer, error messages on Telegram): en or id.
UI_LANGUAGE=id
# Dates and times in the minutes use this time zone.
TZ=Asia/Jakarta

# Speech-to-text (OpenAI-compatible /audio/transcriptions). Local STT API, bypassing Caddy.
STT_BASE_URL=http://127.0.0.1:8110/v1
STT_API_KEY=
STT_MODEL=whisper-1
# Default language when the extension leaves it empty (id also works for Indonesian mixed with English).
STT_LANGUAGE=id

# Vision (OpenAI-compatible /chat/completions with images). Local vision API, bypassing Caddy.
VISION_BASE_URL=http://127.0.0.1:8100/v1
VISION_API_KEY=
VISION_MODEL=quality
VISION_BATCH_SIZE=1
VISION_TEMPERATURE=0
VISION_EXTRA_BODY={"max_tokens": 512}
# false = do not read the screenshots (minutes without images).
VISION_ENABLED=true

# Summary: any OpenAI-compatible chat API (OpenAI, Groq, OpenRouter, ...).
SUMMARY_BASE_URL=https://api.openai.com/v1
SUMMARY_API_KEY=
SUMMARY_MODEL=gpt-4.1-mini
# Empty for reasoning models (gpt-5, o-series), which reject a temperature.
SUMMARY_TEMPERATURE=
SUMMARY_JSON_MODE=true

# Telegram: create a bot with @BotFather, send /start to it (or add it to a group), then
# find the chat id with: curl -s https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: a Chromium binary for the PDF (default: the one playwright-core installed).
CHROMIUM_PATH=
